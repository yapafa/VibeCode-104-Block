{
  "manifest_version": 3,
  "name": "LinkedIn 職缺與公司黑名單過濾器",
  "version": "1.3",
  "description": "過濾 LinkedIn 上的特定公司與單一職缺，支援黑名單管理與備份",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/jobs/*",
        "*://*.linkedin.com/jobs/search*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
